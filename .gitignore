# virtualenv (project-local, created by run.sh)
.venv/
# downloads go here (keep the dir, ignore its contents)
downloads/*
!downloads/.gitkeep
# user cookies (never commit — session + per-job isolates)
cookies/*.txt
!cookies/.gitkeep
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# local agent tooling — not part of the product
.agents/
skills-lock.json
